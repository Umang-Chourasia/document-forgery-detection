# URL of the CAT-Net inference backend on the local network, e.g. http://192.168.1.50:8000
VITE_API_BASE_URL=

# Set to "false" to call the real backend above instead of the in-browser mock API.
VITE_USE_MOCK_API=true

# URL of the local narrative-service (holds the Gemini key server-side). Leave
# blank to skip the narrative step entirely (heatmap-only, no Gemini call).
VITE_NARRATIVE_BASE_URL=http://localhost:4000

# Supabase — publishable (anon) key only. Safe for the browser; RLS protects data.
# NEVER put a service-role/secret key in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
